    {{ statsTable("Stopping, restarting and cancelling check ins", "Percentage of people", [
      ["Number of check ins cancelled by the practitioner", stats.checkinsCancelledByPractitioner],
      ["Number of people who have been automatically stopped", stats.peopleAutomaticallyStopped, stats.pctPeopleAutomaticallyStopped],
      ["Number of people who have been stopped by their practitioner", stats.peopleStoppedByPractitioner, stats.pctPeopleStoppedByPractitioner],
      ["Number of people who have been restarted by their practitioner", stats.peopleRestartedByPractitioner, stats.pctPeopleRestartedByPractitioner]
    ]) }}
    {{ recurringCheckinsTable(stats) }}
  {% endset %}

