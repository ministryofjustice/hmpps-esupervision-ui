{% extends "../../partials/layout.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "../../partials/v2statistics/dashboard-filters.njk" import dashboardFilters %}

{% set themeCount = 8 %}

{# Tab panel heading. The position is read out so screen reader users know which tab they are on. #}
{% macro themeHeading(title, position) %}
  <h2 class="govuk-heading-m">
    {{ title }}<span class="govuk-visually-hidden">, tab {{ position }} of {{ themeCount }}</span>
  </h2>
{% endmacro %}

{#
  A theme table with a row label column, a value column and an optional percentage column.
  rows: [label, value] or [label, value, percentage]. A row without a percentage leaves that cell empty.
  With no percentageHeading the third column stays empty, so values line up with the other tables.
  Missing values show as 0, or 0.00% for percentages.
#}
{% macro statsTable(caption, percentageHeading, rows, valueHeading = "Total") %}
  {% set tableRows = [] %}
  {% for row in rows %}
    {% set cells = [
      { text: row[0], classes: "govuk-!-font-weight-bold" },
      { text: row[1] | default(0) }
    ] %}
    {% set _ = cells.push({ text: (row[2] | percentage(2)) if row.length > 2 else "" }) %}
    {% set _ = tableRows.push(cells) %}
  {% endfor %}
  {{ govukTable({
    caption: caption,
    captionClasses: "govuk-table__caption--s",
    head: [
      { text: "" },
      { text: valueHeading, classes: "govuk-!-width-one-quarter" },
      { text: percentageHeading or "", classes: "govuk-!-width-one-third" }
    ],
    rows: tableRows
  }) }}
{% endmacro %}

{# Shown on both How the service is used and Scheduling, as in the Figma #}
{% macro recurringCheckinsTable(stats) %}
  {{ statsTable("Recurring vs one at a time check ins scheduled", "Percentage of people", [
    ["Number of people actively using the service scheduled for recurring check ins", stats.peopleOnRecurringCheckins, stats.pctPeopleOnRecurringCheckins],
    ["Number of people actively using the service scheduled for ad-hoc check ins", stats.peopleOnAdHocCheckins, stats.pctPeopleOnAdHocCheckins]
  ]) }}
{% endmacro %}

{# Visible tab name, with extra words only screen readers hear #}
{% macro tabLabel(text, hiddenBefore = "", hiddenAfter = "") -%}
  {%- if hiddenBefore %}<span class="govuk-visually-hidden">{{ hiddenBefore }} </span>{% endif -%}
  {{ text }}
  {%- if hiddenAfter %}<span class="govuk-visually-hidden"> {{ hiddenAfter }}</span>{% endif -%}
{%- endmacro %}

{% block content %}
  <h1 class="govuk-heading-l">Check in with your probation officer data dashboard</h1>
