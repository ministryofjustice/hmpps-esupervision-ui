{% extends "../../partials/layout.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{%- from "moj/components/sub-navigation/macro.njk" import mojSubNavigation -%}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "../../partials/v2statistics/dashboard-filters.njk" import dashboardFilters %}

{% set themeCount = 8 %}

{# Tab panel heading. The position is read out so screen reader users know which tab they are on. #}
{% macro themeHeading(title, position) %}
  <h2 class="govuk-heading-m">
    {{ title }}<span class="govuk-visually-hidden">, tab {{ position }} of {{ themeCount }}</span>
  </h2>
{% endmacro %}

{% macro dataNotAvailable() %}
  <div class="govuk-inset-text">Data for this theme is not available yet.</div>
{% endmacro %}

{% block content %}
  <h1 class="govuk-heading-l">Check in with your probation officer data dashboard</h1>
  <p class="govuk-body">Missing data is where tracking had not been implemented as service went live.</p>
  <p class="govuk-body">This data was last updated on {{ date }} at {{ time }}.</p>
  {% if errors %}
    {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [
          {
            text: errors.monthRange,
            href: "#monthFrom"
          }
        ]
      }) }}
  {% endif %}

  {{ dashboardFilters({
    formAction: formAction,
    fromMonthOptions: fromMonthOptions,
    toMonthOptions: toMonthOptions,
    regionOptions: regionOptions,
    resetHref: "/v2statistics",
    errors: errors,
    open: filtersApplied
  }) }}

  {{ mojSubNavigation({
    label: "Sub navigation",
    items: [
      {
        text: "Overall",
        active: true
      },
      {
        text: "Data by Region",
        href: "/v2statistics/region?monthFrom=" + monthFrom + "&monthTo=" + monthTo
      }
    ]
  }) }}

  <h2 class="govuk-heading-m">Key data at a glance</h2>
  {% set keyData = [
    { value: stats.completedCheckins, text: "check ins completed" },
    { value: stats.notCompletedOnTime, text: "check ins missed" },
    { value: stats.signedUp, text: "people signed up to the service" },
    { value: stats.activeUsers, text: "people actively using the service" },
    { value: stats.inactiveUsers, text: "people who have stopped using the service" }
  ] %}
  <ul class="app-stat-cards" role="list">
    {% for item in keyData %}
      <li class="app-stat-card">
        <p class="govuk-body govuk-!-margin-bottom-0">
          <span class="app-stat-card__value govuk-heading-m govuk-!-margin-bottom-2">{{ item.value | default(0) }}</span>
          {{ item.text }}
        </p>
      </li>
    {% endfor %}
  </ul>

  <h2 class="govuk-heading-m">View data by theme</h2>

  {% set serviceUsePanel %}
    {{ themeHeading("How the service is used", 1) }}
    {{ govukTable({
      caption: "People on probation",
      captionClasses: "govuk-table__caption--s",
      head: [
        { text: "" },
        { text: "Total", classes: "govuk-!-width-one-quarter" },
        { text: "Percentage of people", classes: "govuk-!-width-one-third" }
      ],
      rows: [
        [
          { text: "Total number of people signed up to the service", classes: "govuk-!-font-weight-bold" },
          { text: stats.signedUp },
          { text: "" }
        ],
        [
          { text: "Number of people actively using the service", classes: "govuk-!-font-weight-bold" },
          { text: stats.activeUsers },
          { text: stats.pctActiveUsers | percentage(2) }
        ],
        [
          { text: "Number of people who have stopped using the service", classes: "govuk-!-font-weight-bold" },
          { text: stats.inactiveUsers },
          { text: stats.pctInactiveUsers | percentage(2) }
        ]
      ]
    }) }}
    {{ govukTable({
      caption: "Check ins",
      captionClasses: "govuk-table__caption--s",
      head: [
        { text: "" },
        { text: "Total", classes: "govuk-!-width-one-quarter" },
        { text: "Percentage of delivered check ins", classes: "govuk-!-width-one-third" }
      ],
      rows: [
        [
          { text: "Number of check ins completed", classes: "govuk-!-font-weight-bold" },
          { text: stats.completedCheckins },
          { text: stats.pctCompletedCheckins | percentage(2) }
        ],
        [
          { text: "Number of check ins not completed on time", classes: "govuk-!-font-weight-bold" },
          { text: stats.notCompletedOnTime },
          { text: stats.pctExpiredCheckins | percentage(2) }
        ],
        [
          { text: "Average number of completed check ins per person", classes: "govuk-!-font-weight-bold" },
          { text: stats.avgCompletedCheckinsPerPerson },
          { text: "" }
        ]
      ]
    }) }}
  {% endset %}

  {% set managingRiskPanel %}
    {{ themeHeading("Managing risk", 2) }}
    {{ dataNotAvailable() }}
  {% endset %}

  {% set schedulingPanel %}
    {{ themeHeading("Scheduling", 3) }}
    {{ dataNotAvailable() }}
  {% endset %}

  {% set linksPanel %}
    {{ themeHeading("Links", 4) }}
    {{ dataNotAvailable() }}
  {% endset %}

  {% set additionalQuestionsPanel %}
    {{ themeHeading("Additional questions", 5) }}
    {{ dataNotAvailable() }}
  {% endset %}

  {% set deviceUsePanel %}
    {{ themeHeading("Device use", 6) }}
    {{ dataNotAvailable() }}
  {% endset %}

  {% set timePanel %}
    {{ themeHeading("Time", 7) }}
    {{ govukTable({
      caption: "Time taken to complete a check in",
      captionClasses: "govuk-table__caption--s",
      head: [
        { text: "" },
        { text: "Total", classes: "govuk-!-width-one-quarter" }
      ],
      rows: [
        [
          { text: "Average time to complete a check in (median)", classes: "govuk-!-font-weight-bold" },
          { text: stats.medianHoursToComplete | hoursToHoursAndMinutes() }
        ],
        [
          { text: "Average time to complete a check in (P90)", classes: "govuk-!-font-weight-bold" },
          { text: stats.p90HoursToComplete | hoursToHoursAndMinutes() }
        ],
        [
          { text: "Number of check ins over 12hrs", classes: "govuk-!-font-weight-bold" },
          { text: stats.delayedSubmissions }
        ]
      ]
    }) }}
  {% endset %}

  {% set feedbackPanel %}
    {{ themeHeading("Feedback", 8) }}
    {% if feedbackAvailable === false %}
      <div class="govuk-inset-text">Feedback is not yet available by region. Select all regions to see feedback.</div>
    {% else %}
      {{ govukTable({
        caption: "Number of responses to the feedback form",
        captionClasses: "govuk-table__caption--s",
        head: [
          {
            text: ""
          },
          {
            text: "Total",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-quarter"
          }
        ],
        rows: [
          [
            {
              text: "Number of responses",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.feedbackTotal | default(0)
            }
          ]
        ]
      }) }}
      {{ govukTable({
        caption: "How easy was it for the person on probation to use online check ins",
        captionClasses: "govuk-table__caption--s",
        head: [
          {
            text: ""
          },
          {
            text: "Total",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-quarter"
          },
          {
            text: "Percentage of responses",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-third"
          }
        ],
        rows: [
          [
            {
              text: "Very easy",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.howEasyCounts.veryEasy | default(0)
            },
            {
              text: feedbackStats.howEasyPct.veryEasy | default(0) | percentage(2)
            }
          ],
          [
             {
              text: "Easy",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.howEasyCounts.easy | default(0)
            },
            {
              text: feedbackStats.howEasyPct.easy | default(0) | percentage(2)
            }
          ],
          [
             {
              text: "Neither easy or difficult",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.howEasyCounts.neitherEasyOrDifficult | default(0)
            },
            {
              text: feedbackStats.howEasyPct.neitherEasyOrDifficult | default(0) | percentage(2)
            }
          ],
          [
             {
              text: "Difficult",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.howEasyCounts.difficult | default(0)
            },
            {
              text: feedbackStats.howEasyPct.difficult | default(0) | percentage(2)
            }
          ],
          [
             {
              text: "Very difficult",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.howEasyCounts.veryDifficult | default(0)
            },
            {
              text: feedbackStats.howEasyPct.veryDifficult | default(0) | percentage(2)
            }
          ],
          [
             {
              text: "Not answered",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.howEasyCounts.notAnswered | default(0)
            },
            {
              text: ""
            }
          ]
        ]
      }) }}
      {{ govukTable({
        caption: "Does the person on probation believe they are getting the support they need from probation",
        captionClasses: "govuk-table__caption--s",
        head: [
          {
            text: ""
          },
          {
            text: "Total",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-quarter"
          },
          {
            text: "Percentage of responses",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-third"
          }
        ],
        rows: [
          [
            {
              text: "Yes",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.gettingSupportCounts.yes | default(0)
            },
            {
              text: feedbackStats.gettingSupportPct.yes | default(0) | percentage(2)
            }
          ],
           [
            {
              text: "No",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.gettingSupportCounts.no | default(0)
            },
            {
              text: feedbackStats.gettingSupportPct.no | default(0) | percentage(2)
            }
          ],
           [
            {
              text: "Not answered",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.gettingSupportCounts.notAnswered | default(0)
            },
            {
              text: ""
            }
          ]
        ]
      }) }}
      {{ govukTable({
        caption: "Do online check ins help the person feel supported by probation",
        captionClasses: "govuk-table__caption--s",
        head: [
          {
            text: ""
          },
          {
            text: "Total",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-quarter"
          },
          {
            text: "Percentage of responses",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-third"
          }
        ],
        rows: [
          [
            {
              text: "Yes",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.helpsFeelSupportedCounts.yes | default(0)
            },
            {
              text: feedbackStats.helpsFeelSupportedPct.yes | default(0) | percentage(2)
            }
          ],
           [
            {
              text: "No",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.helpsFeelSupportedCounts.no | default(0)
            },
            {
              text: feedbackStats.helpsFeelSupportedPct.no | default(0) | percentage(2)
            }
          ],
           [
            {
              text: "Not answered",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.helpsFeelSupportedCounts.notAnswered | default(0)
            },
            {
              text: ""
            }
          ]
        ]
      }) }}
      {{ govukTable({
        caption: "Does using online check ins mean the person needs to get in touch with their probation officer less",
        captionClasses: "govuk-table__caption--s",
        head: [
          {
            text: ""
          },
          {
            text: "Total",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-quarter"
          },
          {
            text: "Percentage of responses",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-third"
          }
        ],
        rows: [
          [
            {
              text: "Yes",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.lessContactNeededCounts.yes | default(0)
            },
            {
              text: feedbackStats.lessContactNeededPct.yes | default(0) | percentage(2)
            }
          ],
           [
            {
              text: "No",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.lessContactNeededCounts.no | default(0)
            },
            {
              text: feedbackStats.lessContactNeededPct.no | default(0) | percentage(2)
            }
          ],
           [
            {
              text: "Not answered",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.lessContactNeededCounts.notAnswered | default(0)
            },
            {
              text: ""
            }
          ]
        ]
      }) }}
      {{ govukTable({
        caption: "What parts of online check ins does the person think we could improve",
        captionClasses: "govuk-table__caption--s",
        head: [
          {
            text: ""
          },
          {
            text: "Total",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-quarter"
          },
          {
            text: "Percentage of responses",
            classes: "govuk-!-font-weight-bold govuk-!-width-one-third"
          }
        ],
        rows: [
          [
            {
              text: "Finding out about online check ins",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.findingOutAboutCheckIns | default(0)
            },
            {
              text: feedbackStats.improvementsPct.findingOutAboutCheckIns | default(0) | percentage(2)
            }
          ],
          [
            {
              text: "Being signed up to online check ins",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.beingSignedUpToCheckIns | default(0)
            },
            {
              text: feedbackStats.improvementsPct.beingSignedUpToCheckIns | default(0) | percentage(2)
            }
          ],
          [
            {
              text: "Text or email notifications",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.textOrEmailNotifications | default(0)
            },
            {
              text: feedbackStats.improvementsPct.textOrEmailNotifications | default(0) | percentage(2)
            }
          ],
          [
            {
              text: "Questions within the check in",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.checkInQuestions | default(0)
            },
            {
              text: feedbackStats.improvementsPct.checkInQuestions | default(0) | percentage(2)
            }
          ],
          [
            {
              text: "Taking a video to check your identity",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.takingAVideo | default(0)
            },
            {
              text: feedbackStats.improvementsPct.takingAVideo | default(0) | percentage(2)
            }
          ],
          [
            {
              text: "Getting help when something goes wrong",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.gettingHelp | default(0)
            },
            {
              text: feedbackStats.improvementsPct.gettingHelp | default(0) | percentage(2)
            }
          ],
          [
            {
              text: "What happened after you told probation you needed support",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.whatHappenedAfterAskingForSupport | default(0)
            },
            {
              text: feedbackStats.improvementsPct.whatHappenedAfterAskingForSupport | default(0) | percentage(2)
            }
          ],
          [
            {
              text: "What happened after you asked for contact from probation ",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.whatHappenedAfterAskingForContact | default(0)
            },
            {
              text: feedbackStats.improvementsPct.whatHappenedAfterAskingForContact | percentage(2)
            }
          ],
          [
            {
              text: "Something else",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.somethingElse | default(0)
            },
            {
              text: feedbackStats.improvementsPct.somethingElse | default(0) | percentage(2)
            }
          ],
          [
            {
              text: "Nothing needs to improve",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.nothingNeedsImproving | default(0)
            },
            {
              text: feedbackStats.improvementsPct.nothingNeedsImproving | default(0) | percentage(2)
            }
          ],
          [
            {
              text: "Not answered",
              classes: "govuk-!-font-weight-bold"
            },
            {
              text: feedbackStats.improvementsCounts.notAnswered | default(0)
            },
            {
              text: ""
            }
          ]
        ]
      }) }}
    {% endif %}
  {% endset %}

  {{ govukTabs({
    id: "data-by-theme",
    title: "Themes",
    items: [
      { label: "How the service is used", id: "how-the-service-is-used", panel: { html: serviceUsePanel } },
      { label: "Managing risk", id: "managing-risk", panel: { html: managingRiskPanel } },
      { label: "Scheduling", id: "scheduling", panel: { html: schedulingPanel } },
      { label: "Links", id: "links", panel: { html: linksPanel } },
      { label: "Additional questions", id: "additional-questions", panel: { html: additionalQuestionsPanel } },
      { label: "Device use", id: "device-use", panel: { html: deviceUsePanel } },
      { label: "Time", id: "time", panel: { html: timePanel } },
      { label: "Feedback", id: "feedback", panel: { html: feedbackPanel } }
    ]
  }) }}
{% endblock %}
