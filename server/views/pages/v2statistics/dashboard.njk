      ["Number of people signed up to the service", stats.signedUp]
    ]) }}
    {{ statsTable("Number of check ins completed and missed", "Percentage of delivered check ins", [
      ["Number of check ins completed", stats.completedCheckins, stats.pctCompletedCheckins],
      ["Number of check ins missed", stats.notCompletedOnTime, stats.pctExpiredCheckins]
